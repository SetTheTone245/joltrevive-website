# Postgres connection string for the API.
# On Vercel this is injected by the Neon Postgres integration.
# Locally, copy this file to .env and paste your own connection string.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Optional: extra browser origins allowed to call the API (comma-separated).
# joltrevive.com, www.joltrevive.com and setthetone245.github.io are always allowed.
ALLOWED_ORIGINS=

# Stripe server secret for hosted Checkout card payments. Do not expose this in
# the browser or add a VITE_ prefix. When absent, the site honestly offers
# phone/in-shop checkout instead.
STRIPE_SECRET_KEY=sk_test_replace_with_your_stripe_secret

# Optional: sends new contact-message and appointment notifications to
# Admin@JoltRevive.com. If RESEND_FROM is omitted, Resend's onboarding sender is
# used (suitable for testing only).
RESEND_API_KEY=re_replace_with_your_resend_key
RESEND_FROM=Jolt Revive <orders@your-verified-domain.example>

# Required to use /#/admin and GET /api/admin/submissions. Generate a random
# high-entropy token; never commit the real value.
ADMIN_TOKEN=replace_with_a_long_random_token
