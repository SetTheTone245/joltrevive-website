# Postgres connection string for the API.
# On Vercel this is injected by the Neon Postgres integration.
# Locally, copy this file to .env and paste your own connection string.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Optional: extra browser origins allowed to call the API (comma-separated).
# joltrevive.com, www.joltrevive.com and setthetone245.github.io are always allowed.
ALLOWED_ORIGINS=
